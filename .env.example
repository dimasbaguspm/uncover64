# Analytics (all optional — the app runs with zero telemetry by default)

# Self-hosted LGTM stack via Grafana Faro (OTLP HTTP collector endpoint).
VITE_FARO_COLLECTOR_URL=https://collector.example.com/v1/traces

# App version shown in the header (injected at build time, e.g. "2.1").
VITE_APP_VERSION=1.0.0
