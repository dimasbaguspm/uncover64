# Analytics (all optional — the app runs with zero telemetry by default)

# Self-hosted LGTM stack via Grafana Faro (OTLP HTTP base endpoint; the app
# posts events to /v1/logs and Faro traces to /v1/traces).
VITE_FARO_COLLECTOR_URL=https://otel.dimasbaguspm.dev

# App version shown in the header (injected at build time).
VITE_APP_VERSION=1.0.0
