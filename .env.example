# Analytics (all optional — the app runs with zero telemetry by default)

# Self-hosted Umami (events: clicks, pastes, encode/decode actions).
VITE_UMAMI_URL=https://analytics.dimasbaguspm.dev
VITE_UMAMI_WEBSITE_ID=

# Self-hosted LGTM stack (logs + tracing via OTLP). The app posts logs to
# /v1/logs and Faro traces to /v1/traces.
VITE_FARO_COLLECTOR_URL=https://otel.dimasbaguspm.dev

# App version shown in the header (injected at build time).
VITE_APP_VERSION=1.0.0
